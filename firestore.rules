rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isEmailVerified() { return request.auth.token.email_verified == true; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function isAdmin() { return isSignedIn() && getUserRole() == 'ADMIN'; }
    function isSupervisor() { return isSignedIn() && getUserRole() == 'SUPERVISOR'; }
    function isFaculty() { return isSignedIn() && getUserRole() == 'FACULTY'; }
    function isStudent() { return isSignedIn() && getUserRole() == 'STUDENT'; }

    // --- Validation Blueprints ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) 
             && data.keys().size() <= 7
             && data.uid == request.auth.uid
             && data.email == request.auth.token.email
             && data.role in ['STUDENT', 'SUPERVISOR', 'FACULTY', 'ADMIN']
             && (data.displayName is string && data.displayName.size() <= 100)
             && (data.department is string && data.department.size() <= 100);
    }

    function isValidEvaluation(data) {
      return data.keys().hasAll(['type', 'evaluatorId', 'targetFacultyId', 'scores', 'timestamp'])
             && data.keys().size() <= 10
             && data.type in ['SET', 'SAF']
             && data.evaluatorId == request.auth.uid
             && data.scores is list
             && data.scores.size() == 15
             && data.timestamp == request.time;
    }

    // --- Rules ---

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidId(userId) && userId == request.auth.uid && isValidUser(incoming());
      allow update: if isSignedIn() && userId == request.auth.uid 
                    && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'department', 'email'])
                    && isValidUser(incoming());
      allow delete: if isAdmin();
    }

    match /faculty/{facultyId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /academicPeriods/{periodId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /sections/{sectionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /evaluations/{evaluationId} {
      allow get: if isSignedIn() && (request.auth.uid == resource.data.evaluatorId || isAdmin() || isFaculty());
      allow list: if isSignedIn() && (
        isAdmin() 
        || resource.data.evaluatorId == request.auth.uid 
        || resource.data.targetFacultyId == request.auth.uid
      );
      allow create: if isSignedIn() && isEmailVerified() && isValidId(evaluationId) && isValidEvaluation(incoming());
      allow update, delete: if isAdmin();
    }
  }
}
